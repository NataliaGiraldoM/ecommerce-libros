---
export const prerender = true;
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
---

<LayoutAdmin titulo="Login">

    <div class="min-h-[75vh] flex items-center justify-center px-4">

        <!-- Card -->
        <div
            class="w-full max-w-md relative overflow-hidden rounded-3xl border border-white/20 bg-white/70 backdrop-blur-xl shadow-[0_20px_60px_rgba(168,85,247,0.25)]"
        >

            <!-- Glow decorativo -->
            <div class="absolute -top-20 -right-20 w-56 h-56 bg-fuchsia-400/30 rounded-full blur-3xl"></div>
            <div class="absolute -bottom-20 -left-20 w-56 h-56 bg-violet-400/30 rounded-full blur-3xl"></div>

            <div class="relative p-10">

                <!-- Header -->
                <div class="text-center mb-8">

                    <div
                        class="w-20 h-20 mx-auto rounded-3xl bg-gradient-to-br from-fuchsia-500 to-violet-600 flex items-center justify-center text-4xl shadow-lg shadow-fuchsia-500/30"
                    >
                        🤍
                    </div>

                    <h1 class="text-4xl font-black text-gray-800 mt-6">
                        Bienvenido
                    </h1>

                    <p class="text-gray-500 mt-2 text-sm">
                        Accede al panel administrativo de Elysian Books
                    </p>

                </div>

                <!-- Error -->
                <div
                    id="error-msg"
                    class="hidden bg-red-100/80 border border-red-200 text-red-700 px-4 py-3 rounded-2xl mb-6 text-sm backdrop-blur"
                >
                </div>

                <!-- Form -->
                <form id="login-form" class="flex flex-col gap-5">

                    <!-- Email -->
                    <div>

                        <label
                            class="block text-sm font-semibold text-gray-700 mb-2"
                        >
                            Correo electrónico
                        </label>

                        <input
                            type="email"
                            id="email"
                            required
                            placeholder="admin@elysianbooks.com"
                            class="w-full bg-white/70 border border-violet-200 rounded-2xl px-5 py-3 text-gray-700 placeholder:text-gray-400 outline-none focus:ring-4 focus:ring-fuchsia-300/40 focus:border-fuchsia-400 transition-all duration-300"
                        />

                    </div>

                    <!-- Password -->
                    <div>

                        <label
                            class="block text-sm font-semibold text-gray-700 mb-2"
                        >
                            Contraseña
                        </label>

                        <input
                            type="password"
                            id="password"
                            required
                            placeholder="••••••••"
                            class="w-full bg-white/70 border border-violet-200 rounded-2xl px-5 py-3 text-gray-700 placeholder:text-gray-400 outline-none focus:ring-4 focus:ring-fuchsia-300/40 focus:border-fuchsia-400 transition-all duration-300"
                        />

                    </div>

                    <!-- Button -->
                    <button
                        type="submit"
                        id="btn-login"
                        class="mt-3 bg-gradient-to-r from-fuchsia-600 to-violet-700 text-white py-3.5 rounded-2xl font-bold text-lg hover:scale-[1.02] hover:shadow-xl hover:shadow-fuchsia-500/30 transition-all duration-300"
                    >
                        Iniciar sesión
                    </button>

                </form>

                <!-- Footer -->
                <p class="text-center text-xs text-gray-400 mt-8">
                    Panel seguro • Solo administradores autorizados
                </p>

            </div>
        </div>
    </div>

</LayoutAdmin>

<script>
    import { supabase } from "../../lib/supabase";

    // Si ya hay sesión activa, redirigir al dashboard
    const {
        data: { session },
    } = await supabase.auth.getSession();
    if (session) window.location.replace("/admin/dashboard");

    const form = document.getElementById("login-form") as HTMLFormElement;
    const errorMsg = document.getElementById("error-msg") as HTMLDivElement;
    const btnLogin = document.getElementById("btn-login") as HTMLButtonElement;

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorMsg.classList.add("hidden");
        btnLogin.textContent = "Ingresando...";
        btnLogin.disabled = true;

        const email = (document.getElementById("email") as HTMLInputElement)
            .value;
        const password = (
            document.getElementById("password") as HTMLInputElement
        ).value;

        const { error } = await supabase.auth.signInWithPassword({
            email,
            password,
        });

        if (error) {
            errorMsg.textContent = "Correo o contraseña incorrectos";
            errorMsg.classList.remove("hidden");
            btnLogin.textContent = "Iniciar sesión";
            btnLogin.disabled = false;
        } else {
            window.location.replace("/admin/dashboard");
        }
    });
</script>