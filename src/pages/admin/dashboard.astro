---
export const prerender = true;
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
---

<LayoutAdmin titulo="Dashboard">
    <div id="estado-carga" class="text-center py-16 text-gray-400">
        <p class="text-4xl mb-4">⏳</p>
        <p>Cargando panel...</p>
    </div>

    <div id="contenido" class="hidden">
        <div
            class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4"
        >
            <div>
                <h1 class="text-4xl font-black text-violet-900 tracking-tight">Dashboard</h1>
                <p class="text-gray-500 mt-1">Gestión del catálogo de libros</p>
            </div>
            <a
                href="/admin/libros/nuevo"
                class="bg-gradient-to-r from-violet-600 to-fuchsia-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-amber-800 transition-colors"
            >
                + Agregar libro
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-10">
            <div
                class="bg-white/80 backdrop-blur rounded-2xl shadow-md p-6 border border-violet-100 hover:shadow-xl transition-all"
            >
                <p class="text-sm text-gray-500 mb-1">Total libros</p>
                <p id="stat-total" class="text-4xl font-bold text-violet-700">
                    —
                </p>
            </div>
            <div
                class="bg-white/80 backdrop-blur rounded-2xl shadow-md p-6 border border-violet-100 hover:shadow-xl transition-all"
            >
                <p class="text-sm text-gray-500 mb-1">En stock</p>
                <p id="stat-stock" class="text-4xl font-bold text-green-600">
                    —
                </p>
            </div>
            <div
                class="bg-white/80 backdrop-blur rounded-2xl shadow-md p-6 border border-violet-100 hover:shadow-xl transition-all"
            >
                <p class="text-sm text-gray-500 mb-1">Agotados</p>
                <p id="stat-agotados" class="text-4xl font-bold text-red-500">
                    —
                </p>
            </div>
        </div>

        <div
            class="bg-white rounded-xl shadow-sm overflow-hidden border border-violet-100"
        >
            <div class="px-6 py-4 border-b border-violet-100">
                <h2 class="text-lg font-bold bg-gradient-to-r from-violet-700 to-fuchsia-600 bg-clip-text text-transparent">
                    Todos los libros
                </h2>
            </div>
            <div
                id="error-tabla"
                class="hidden px-6 py-8 text-center text-red-500 text-sm"
            >
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-violet-50 text-violet-900 uppercase text-xs">
                        <tr>
                            <th class="px-6 py-3 text-left">Libro</th>
                            <th class="px-6 py-3 text-left">Categoría</th>
                            <th class="px-6 py-3 text-left">Precio</th>
                            <th class="px-6 py-3 text-left">Stock</th>
                            <th class="px-6 py-3 text-left">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-libros" class="divide-y divide-violet-50"
                    ></tbody>
                </table>
            </div>
        </div>
    </div>
</LayoutAdmin>

<script>
    import { supabase } from "../../lib/supabase";

    async function cargarLibros(session: any) {
        document.getElementById("estado-carga")!.classList.add("hidden");
        document.getElementById("contenido")!.classList.remove("hidden");

        const { data: libros, error } = await supabase
            .from("libros")
            .select("*")
            .order("created_at", { ascending: false });

        if (error || !libros) {
            const errorTabla = document.getElementById("error-tabla")!;
            errorTabla.textContent =
                "Error al cargar los libros: " + error?.message;
            errorTabla.classList.remove("hidden");
            return;
        }

        document.getElementById("stat-total")!.textContent = String(
            libros.length,
        );
        document.getElementById("stat-stock")!.textContent = String(
            libros.filter((l) => l.stock > 0).length,
        );
        document.getElementById("stat-agotados")!.textContent = String(
            libros.filter((l) => l.stock === 0).length,
        );

        const tbody = document.getElementById("tabla-libros")!;
        tbody.innerHTML = libros
            .map(
                (libro) => `
            <tr class="hover:bg-violet-50 transition-colors">
                <td class="px-6 py-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-violet-100 rounded-lg flex items-center justify-center flex-shrink-0 overflow-hidden">
                            ${
                                libro.imagen_url
                                    ? `<img src="${libro.imagen_url}" alt="${libro.titulo}" class="w-full h-full object-cover"/>`
                                    : `<span>📖</span>`
                            }
                        </div>
                        <div>
                            <p class="font-medium text-gray-800 line-clamp-1">${libro.titulo}</p>
                            <p class="text-gray-400 text-xs">${libro.autor}</p>
                        </div>
                    </div>
                </td>
                <td class="px-6 py-4">
                    <span class="bg-violet-100 text-violet-700 text-xs px-2 py-1 rounded-full">
                        ${libro.categoria}
                    </span>
                </td>
                <td class="px-6 py-4 font-medium text-fuchsia-600">
                    $${libro.precio.toLocaleString("es-CO")}
                </td>
                <td class="px-6 py-4">
                    <span class="${libro.stock > 0 ? "text-green-600" : "text-red-500"} font-medium">
                        ${libro.stock > 0 ? libro.stock + " uds." : "Agotado"}
                    </span>
                </td>
                <td class="px-6 py-4">
                    <div class="flex gap-2">
                        <a href="/admin/libros/editar?id=${libro.id}" class="text-violet-600 hover:text-fuchsia-600 font-medium transition-colors">
                            Editar
                        </a>
                        <span class="text-gray-300">|</span>
                        <button onclick="eliminarLibro('${libro.id}', '${libro.imagen_url ?? ""}')" class="text-red-500 hover:text-red-700 font-medium transition-colors">
                            Eliminar
                        </button>
                    </div>
                </td>
            </tr>
        `,
            )
            .join("");
    }

    async function eliminarLibro(id: string, imagenUrl: string) {
        if (!confirm("¿Seguro que quieres eliminar este libro?")) return;

        if (imagenUrl) {
            const path = imagenUrl.split(
                "/storage/v1/object/public/libros-imagenes/",
            )[1];
            if (path)
                await supabase.storage.from("libros-imagenes").remove([path]);
        }

        const { error } = await supabase.from("libros").delete().eq("id", id);
        if (error) {
            alert("Error al eliminar: " + error.message);
        } else {
            window.location.reload();
        }
    }

    (window as any).eliminarLibro = eliminarLibro;

    // Usar onAuthStateChange para esperar correctamente la sesión
    supabase.auth.onAuthStateChange((event, session) => {
        if (event === "INITIAL_SESSION") {
            if (!session) {
                window.location.replace("/admin/login");
            } else {
                cargarLibros(session);
            }
        }
    });
</script>
