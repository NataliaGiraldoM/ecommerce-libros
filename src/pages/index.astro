---
import LayoutCatalogo from "../layouts/LayoutCatalogo.astro";
import { supabase } from "../lib/supabase";

const response = await supabase
	.from("libros")
	.select("*")
	.order("created_at", { ascending: false })
	.limit(4);

const librosDestacados = response.data;
const error = response.error;
---

<LayoutCatalogo titulo="Inicio">

	<!-- Hero -->
	<section
		class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-violet-700 via-fuchsia-600 to-purple-800 px-8 py-20 mb-16 text-center shadow-2xl"
	>

		<!-- Glow decorativo -->
		<div class="absolute -top-20 -left-20 w-72 h-72 bg-pink-300/30 rounded-full blur-3xl"></div>
		<div class="absolute -bottom-20 -right-20 w-72 h-72 bg-violet-300/30 rounded-full blur-3xl"></div>

		<div class="relative z-10">

			<div class="mb-6 text-6xl">
				
			</div>

			<h1 class="text-5xl md:text-6xl font-black mb-6 text-white tracking-tight leading-tight">
				Bienvenido a Elysian Books
			</h1>

			<p class="text-xl text-violet-100 mb-10 max-w-2xl mx-auto leading-relaxed">
				Descubre historias increíbles, autores inolvidables y
				tus próximos libros favoritos en un solo lugar 💜
			</p>

			<a
				href="/libros"
				class="inline-flex items-center gap-2 bg-white text-violet-700 font-bold px-8 py-4 rounded-2xl shadow-lg hover:scale-105 text-lg hover:bg-violet-50 transition-all duration-300"
			>
				Explorar catálogo
			</a>

		</div>

	</section>

	<!-- Libros destacados -->
	<section>

		<div class="flex items-center justify-between mb-8">

			<div>
				<h2 class="text-4xl font-black text-violet-900 tracking-tight">
					Novedades 
				</h2>

				<p class="text-gray-500 mt-2">
					Los libros más recientes de nuestra colección
				</p>
			</div>

		</div>

		{
			error && (
				<p class="text-red-500">
					Error al cargar libros: {error.message}
				</p>
			)
		}

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">

			{
				librosDestacados?.map((libro) => (

					<a
						href={`/libros/${libro.id}`}
						class="group bg-white/80 backdrop-blur rounded-[2rem] shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 overflow-hidden border border-violet-100"
					>

						<div class="bg-gradient-to-br from-violet-100 to-fuchsia-100 h-56 flex items-center justify-center overflow-hidden">

							{libro.imagen_url ? (
								<img
									src={libro.imagen_url}
									alt={libro.titulo}
									class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
								/>
							) : (
								<span class="text-7xl">📖</span>
							)}

						</div>

						<div class="p-5">

							<h3 class="font-bold text-lg text-gray-800 group-hover:text-fuchsia-600 transition-colors line-clamp-2">
								{libro.titulo}
							</h3>

							<p class="text-gray-500 text-sm mt-2">
								{libro.autor}
							</p>

							<div class="mt-4 flex items-center justify-between">

								<p class="text-fuchsia-600 font-extrabold text-lg">
									${libro.precio.toLocaleString("es-CO")}
								</p>

								<span class="text-sm text-violet-500 font-medium">
									Ver más →
								</span>

							</div>

						</div>

					</a>

				))
			}

		</div>

	</section>

</LayoutCatalogo>