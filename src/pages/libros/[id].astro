---
import LayoutCatalogo from "../../layouts/LayoutCatalogo.astro";
import { supabase } from "../../lib/supabase";

const { id } = Astro.params;

const { data: libro, error } = await supabase
    .from("libros")
    .select("*")
    .eq("id", id)
    .single();

if (!libro || error) {
    return Astro.redirect("/libros");
}
---

<LayoutCatalogo titulo={libro.titulo}>
    <!-- Botón volver -->
    <a
        href="/libros"
        class="inline-flex items-center gap-2 text-violet-600 hover:text-fuchsia-600 mb-8 font-semibold transition-colors"
    >
        ← Volver al catálogo
    </a>

    <div class="bg-white/80 backdrop-blur rounded-[2rem] shadow-2xl overflow-hidden border border-violet-100">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
            <!-- Imagen -->
            <div
                class="bg-gradient-to-br from-violet-100 to-fuchsia-100 h-96 md:h-auto flex items-center justify-center p-8"
            >
                {
                    libro.imagen_url ? (
                        <img
                            src={libro.imagen_url}
                            alt={libro.titulo}
                            class="max-h-80 object-contain rounded-2xl shadow-xl hover:scale-105 transition-transform duration-500"
                        />
                    ) : (
                        <span class="text-9xl">📖</span>
                    )
                }
            </div>

            <!-- Información -->
            <div class="p-8 flex flex-col justify-center">
                <span
                    class="text-sm bg-violet-100 text-violet-700 px-4 py-1 rounded-full w-fit mb-5 font-medium"
                >
                    {libro.categoria}
                </span>

                <h1 class="text-5xl font-black text-violet-950 mb-3 tracking-tight">
                    {libro.titulo}
                </h1>
                <p class="text-2xl text-gray-500 mb-8">por {libro.autor}</p>

                {
                    libro.descripcion && (
                        <p class="text-gray-600 leading-relaxed mb-8 text-lg">
                            {libro.descripcion}
                        </p>
                    )
                }

                <div class="flex items-center gap-4 mb-6">
                    <span class="text-5xl font-black bg-gradient-to-r from-violet-700 to-fuchsia-600 bg-clip-text text-transparent">
                        ${libro.precio.toLocaleString("es-CO")}
                    </span>
                    <span
                        class={libro.stock > 0
                            ? "text-green-600 font-medium"
                            : "text-red-500 font-medium"}
                    >
                        {
                            libro.stock > 0
                                ? libro.stock + " disponibles"
                                : "Agotado"
                        }
                    </span>
                </div>

                <button
                    class="bg-gradient-to-r from-violet-600 to-fuchsia-600 text-white px-10 py-4 rounded-2xl font-bold text-lg hover:scale-105 hover:shadow-xl transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed w-full md:w-auto"
                    disabled={libro.stock === 0}
                >
                    {libro.stock > 0 ? "Agregar al carrito" : "No disponible"}
                </button>
            </div>
        </div>
    </div>
</LayoutCatalogo>
